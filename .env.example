# Copy to .env.local (npm run setup does this and generates secrets). Never commit real values.

# Database: "pglite://.data/pglite" (embedded, local dev) or a PostgreSQL URL in production.
DATABASE_URL=pglite://.data/pglite

# Public base URL of this app (links in e-mails, payment return URLs, order tracking links).
APP_URL=http://localhost:3000

# 32 random bytes, base64. Encrypts two-step verification seeds at rest. Rotate with care.
APP_ENCRYPTION_KEY=

# inline = run background jobs inside the web process (required with PGlite and on shared hosting).
WORKER_MODE=inline

# Shared secret for {APP_URL}/api/cron/tick (cPanel cron keeps background jobs running). 32+ random characters.
CRON_SECRET=

# Live page updates: "sse" (VPS) or "poll" (shared hosting). Applied at build time.
NEXT_PUBLIC_LIVE_UPDATES=sse

# Max PostgreSQL connections per app process (keep low on shared hosting).
DB_POOL_MAX=5

# Where uploaded pictures are stored. Must be outside the app folder (each deploy replaces it).
# Empty = .data/uploads in development, ../kvs-data/uploads (next to the app) in production.
UPLOAD_DIR=

# Password for seeded demonstration accounts (generated by npm run setup). Development only.
SEED_DEMO_PASSWORD=

# E-mail: "console" (development: messages appear at /dev/mailbox) or "smtp" (hosting mailbox).
MAIL_ADAPTER=console
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="KingsView Solutions <no-reply@example.com>"

# Paystack (KingsView's own account). TEST keys (sk_test_…) until go-live. Webhook URL: {APP_URL}/api/webhooks/paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_CHANNELS=card,mobile_money

# Synclytics (SES) partner link — values come from SES when it creates the KingsView connection.
# Leave empty to keep the link off. SES's inbound secret signs what we send; SES's outbound secret verifies what SES sends.
# SES must register {APP_URL}/api/ses/events as this connection's outbound URL.
SES_BASE_URL=
SES_CONNECTION_ID=
SES_SIGNING_SECRET=
SES_VERIFY_SECRET=
# "test" while pointing at SES's simulator/staging, "production" once live.
SES_MODE=test
