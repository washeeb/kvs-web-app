# Copy to .env.local (npm run setup does this and generates secrets). Never commit real values.

# Database: "pglite://.data/pglite" (embedded, local dev) or a PostgreSQL URL in production.
DATABASE_URL=pglite://.data/pglite

# Public base URL of this app (links in e-mails, payment return URLs). Production: https://synclyticsenterprisesystems.com
APP_URL=http://localhost:3000

# 32 random bytes, base64. Encrypts integration secrets and MFA seeds at rest. Rotate with care.
APP_ENCRYPTION_KEY=

# inline = run background jobs inside the web process (required with PGlite).
# external = run `npm run worker` as a separate process (production with PostgreSQL).
WORKER_MODE=inline

# Shared secret for {APP_URL}/api/cron/tick (cPanel cron keeps background jobs running). 32+ random characters.
CRON_SECRET=

# Live page updates: "sse" (VPS) or "poll" (shared hosting). Applied at build time.
NEXT_PUBLIC_LIVE_UPDATES=sse

# Where uploaded documents are stored. Must be OUTSIDE the app folder (deployments replace it).
# Default: .data/uploads in development, ../ses-data/uploads in production. Include it in backups.
UPLOAD_DIR=

# Max PostgreSQL connections per app process (keep low on shared hosting).
DB_POOL_MAX=5

# Enables the KingsView simulator. Must stay false in production.
SIMULATORS_ENABLED=true

# Password for seeded demonstration accounts (generated by npm run setup).
SEED_DEMO_PASSWORD=

# E-mail: "console" (development: messages appear at /dev/mailbox) or "smtp" (hosting mailbox, e.g. InMotion).
MAIL_ADAPTER=console
# SMTP settings from cPanel → Email Accounts → Connect Devices (use port 465 with SSL).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Synclytics Enterprise Systems <no-reply@synclyticsenterprisesystems.com>"

# Paystack. Use TEST keys (sk_test_…) until go-live. Webhook URL: {APP_URL}/api/webhooks/paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_CHANNELS=card,mobile_money

# Optional AI assistance (staff suggestions). Off unless set AND switched on in Company settings.
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
